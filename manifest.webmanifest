{
  "id": "./",
  "name": "Daybook — Life & Trade Journal",
  "short_name": "Daybook",
  "description": "Your private daily journal for food, learning, training, money and mood — plus a professional trade journal with analytics. Works offline; your data stays on your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5f8",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "lifestyle", "health", "finance", "education"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Open today's journal",
      "url": "./#/today",
      "icons": [{ "src": "assets/icons/shortcut-today.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Log a new expense",
      "url": "./#/expenses?new=1",
      "icons": [{ "src": "assets/icons/shortcut-expense.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Log meal",
      "short_name": "Meal",
      "description": "Log what you ate",
      "url": "./#/food?new=1",
      "icons": [{ "src": "assets/icons/shortcut-meal.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Log trade",
      "short_name": "Trade",
      "description": "Journal a new trade",
      "url": "./#/trades?new=1",
      "icons": [{ "src": "assets/icons/shortcut-trade.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
